{
  "name": "tv-caster",
  "version": "1.0.0",
  "description": "Play web videos in your TV's own player over DLNA (not screen mirroring)",
  "scripts": {
    "test": "node --experimental-strip-types --test src/*.test.ts",
    "start": "node --env-file-if-exists=.env --experimental-strip-types src/server.ts",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "check": "tsc"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
